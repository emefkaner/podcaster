# ---- Zugang ----
# Passwort für den Login (nur du sollst rein). Bitte ändern!
APP_PASSWORD=bitte-aendern
# Zufälliger, langer Wert zum Signieren der Login-Cookies. Bitte ändern!
SESSION_SECRET=bitte-einen-langen-zufallswert-eintragen

# ---- Öffentliche Adresse der App ----
# Vollständige URL, unter der die App erreichbar ist (ohne Slash am Ende).
# WICHTIG für den RSS-Feed: Spotify braucht absolute Links zu den MP3s.
# Beispiel: https://mein-podcast.onrender.com
PUBLIC_URL=http://localhost:3000

# ---- Transkription + Infotext (empfohlen: Gemini) ----
# Google-Gemini-Key: macht BEIDES (Audio -> Text und Text -> Beschreibung).
# Kostenloser Kontingentbereich, keine Kreditkarte nötig, gut bei Deutsch/Eigennamen.
# Hier erstellen: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- Optionale Alternativen ----
# OpenAI (Whisper) – wird nur genutzt, wenn kein Gemini-Key gesetzt ist.
OPENAI_API_KEY=
# Anthropic (Claude) – alternative Quelle für den Infotext.
ANTHROPIC_API_KEY=

# ---- Speicher ----
# Lokaler Ordner für Zwischenspeicher/Uploads (und Fallback ohne R2).
DATA_DIR=./data

# ---- Cloudflare R2 (empfohlen: dauerhafter, kostenloser Audio-Speicher) ----
# Alle fünf Werte setzen, dann laufen MP3s, Cover und Metadaten über R2.
# Fehlt einer, nutzt die App automatisch die lokale Platte.
# Cloudflare-Dashboard -> R2 -> Bucket anlegen, API-Token erstellen,
# und den Bucket "öffentlich" schalten (r2.dev-Subdomain oder eigene Domain).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Öffentliche Basis-URL des Buckets, z. B. https://pub-xxxxxxxx.r2.dev
R2_PUBLIC_URL=

# ---- Spotify for Podcasters / Anchor (optionaler Direkt-Push) ----
# Zugangsdaten deines bestehenden Podcast-Kontos (E-Mail + Passwort, KEIN 2FA).
# Nur nötig, wenn du Folgen direkt in deine bestehende Show pushen willst.
# Achtung: inoffizieller Weg über Browser-Automation, gegen Spotify-ToS.
ANCHOR_EMAIL=
ANCHOR_PASSWORD=

# ---- Server ----
PORT=3000

# ---- ffmpeg (optional) ----
# Normalerweise nicht nötig: im Docker-Image ist ffmpeg installiert und liegt im PATH.
# Nur setzen, wenn ffmpeg/ffprobe an einem speziellen Pfad liegen.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# ---- Higgsfield (bevorzugte Quelle für Folgen-Cover) ----
# Nutzt den Soul-Modus mit Referenzbildern, damit Gesichter erhalten bleiben.
# Schlüssel unter https://higgsfield.ai (Konto -> API).
# Sind beide gesetzt, wird Higgsfield statt Gemini für Bilder genutzt.
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
# Modell und Auflösung für Higgsfield-Cover (optional).
# HIGGSFIELD_MODEL=nano_banana_2
# HIGGSFIELD_RESOLUTION=1k
# Nur setzen, wenn ein anderer Pfad als /v1/text2image/soul nötig ist:
# HIGGSFIELD_ENDPOINT=
